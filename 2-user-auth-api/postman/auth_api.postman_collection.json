{
  "info": {
    "_postman_id": "auth-api-collection-week2",
    "name": "Week 2 - User Authentication API",
    "description": "Postman testing collection for User Registration, Login, and JWT Protected Routes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Welcome Endpoint",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": [""]
        }
      }
    },
    {
      "name": "2. User Registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Vaibhavi Shetty\",\n  \"email\": \"vaibhavi@example.com\",\n  \"password\": \"secret123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "3. User Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"vaibhavi@example.com\",\n  \"password\": \"secret123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "4. Get Current User Profile (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer YOUR_JWT_TOKEN_HERE"
          }
        ],
        "url": {
          "raw": "http://localhost:5001/api/auth/me",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "auth", "me"]
        }
      }
    }
  ]
}
